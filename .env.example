# Modelo das variáveis do stella-frontend.
# - Desenvolvimento: copie para .env.local (fora do Git).
# - Produção: cadastre no painel do provedor (ex: Vercel > Settings > Environment Variables).
# Variáveis NEXT_PUBLIC_* vão para o navegador: nunca coloque segredos aqui.

# URL base da API, com /api/v1. Produção: https://api.usestella.app/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Client ID público do Google OAuth (o client secret fica só no back-end)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
